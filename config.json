{
  "_说明": "接口聚合配置文件",

  "sources": [
    {
      "_说明": "嗷呜源，图片隐写+Base64格式（WEBP图片尾部追加Base64编码的JSON）",
      "name": "嗷呜",
      "url": "http://www.xn--nsr30bl8nb2kyt7a8vs.top/tv",
      "encrypted": false,
      "format": "image_base64"
    },
    {
      "_说明": "潇洒源，AES-CBC加密格式（$# + key + #$ + 密文hex + iv）",
      "name": "潇洒",
      "url": "https://9877.kstore.space/ONE/one.json",
      "encrypted": true
    },
    {
      "_说明": "王二小放牛娃，明文JSON，需要okhttp UA",
      "name": "王二小放牛娃",
      "url": "http://new.xn--4kq62z5rby2qupq9ub.top",
      "encrypted": false
    },
    {
      "_说明": "本地自定义接口（Python爬虫等），直接追加不参与跨源去重",
      "name": "自定义",
      "url": "file://api.json",
      "encrypted": false,
      "skip_dedup": true
    }
  ],

  "output": "tvbox.json",

  "request": {
    "_说明": "请求参数：timeout秒数、UA标识、失败重试次数",
    "timeout": 15,
    "user_agent": "okhttp/4.12.0",
    "retries": 2
  },

  "merge": {
    "_说明": "合并策略：按key精确去重，保留首次出现的",
    "deduplicate_sites": true,
    "deduplicate_by": "key",
    "keep_first": true
  },

  "filter": {
    "_说明": "站点名包含以下关键词的会被过滤掉（先过滤再去重）",
    "exclude_keywords": ["爱看", "哔哩", "Bili", "直播", "Live", "推送", "教育", "课堂", "体育", "戏曲", "听书", "相声", "小品", "我的", "本地", "DIY", "更新日期", "儿歌", "跳舞", "磁力", "网盘", "给力", "分享", "音乐", "KTV", "电台", "舞曲", "搜索", "盘搜", "教学", "知识", "云盘", "看球", "DJ", "FM", "墙外", "王二小放牛娃", "综合", "新片"],
    "source_exclude": {
      "_说明": "按源名称单独过滤：该源中站点名包含指定关键词的会被移除",
      "潇洒": ["4K", "动漫"],
      "王二小放牛娃": ["4K", "动漫"]
    }
  },

  "dedup_aliases": {
    "_说明": "同义词归类：core_name不同但实质相同的站点归为一组，跨源只保留第一个",
    "豆瓣": ["豆瓣推荐", "豆瓣首页"],
    "虎牙": ["虎牙Live", "虎牙直播"]
  },

  "sort_order": {
    "_说明": "站点分类排序规则：按关键词匹配归类，依此顺序排列。未匹配的放在最后",
    "categories": [
      {"name": "置顶", "keywords": ["豆瓣", "更新日期", "配置", "推荐"]},
      {"name": "采集", "keywords": ["采集", "cj_"]},
      {"name": "4K网盘", "keywords": ["4K"]},
      {"name": "秒播", "keywords": ["秒播"]},
      {"name": "2K", "keywords": ["2K"]},
      {"name": "影视", "keywords": ["快速", "APP", "影视"]},
      {"name": "动漫", "keywords": ["动漫"]},
      {"name": "短剧", "keywords": ["短剧", "漫剧", "漫短"]},
      {"name": "墙外", "keywords": ["墙外"]},
      {"name": "直播", "keywords": ["Live", "直播"]}
    ]
  }
}
